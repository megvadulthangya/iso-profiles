#!/usr/bin/env bash
# Nvidia 340xx / 390xx teljes tisztító script
# Használat: ./nvidia-clean.sh [--dry-run] [--yes]

set -uo pipefail

DRY_RUN=0
ASSUME_YES=0
for arg in "$@"; do
    case "$arg" in
        --dry-run|-n) DRY_RUN=1 ;;
        --yes|-y)     ASSUME_YES=1 ;;
        -h|--help)
            echo "Használat: $0 [--dry-run] [--yes]"
            exit 0 ;;
    esac
done

R='\033[0;31m'; G='\033[0;32m'; Y='\033[1;33m'; B='\033[0;34m'; N='\033[0m'
info()  { echo -e "${B}[*]${N} $*"; }
ok()    { echo -e "${G}[+]${N} $*"; }
warn()  { echo -e "${Y}[!]${N} $*"; }
err()   { echo -e "${R}[-]${N} $*" >&2; }

run() {
    if (( DRY_RUN )); then
        echo -e "${Y}[dry]${N} $*"
    else
        "$@"
    fi
}

require_root() {
    if [[ $EUID -ne 0 ]]; then
        err "Root jog kell. Futtasd: sudo $0 $*"
        exit 1
    fi
}

confirm() {
    (( ASSUME_YES )) && return 0
    read -r -p "$1 [y/N] " ans
    [[ "${ans,,}" == "y" || "${ans,,}" == "yes" ]]
}

# ============================================================
cleanup_packages() {
    info "Telepített nvidia 340xx/390xx csomagok keresése..."

    local pkgs
    pkgs=$(pacman -Qq 2>/dev/null | grep -E \
        '^(nvidia-(340xx|390xx).*|opencl-nvidia-(340xx|390xx).*|lib32-(nvidia|opencl-nvidia)-(340xx|390xx).*|mhwd.*|nvidia-utils-(340xx|390xx).*)$' \
        | sort -u)

    if [[ -z "$pkgs" ]]; then
        ok "Nincs telepítve 340xx/390xx csomag."
    else
        echo "$pkgs" | sed 's/^/    /'
        if confirm "Eltávolítsam ezeket?"; then
            # shellcheck disable=SC2086
            run pacman -Rns --noconfirm $pkgs || warn "pacman -Rns hibázott (talán függőség)."
            ok "Csomagok eltávolítva."
        fi
    fi

    if confirm "Orphan csomagok törlése (pacman -Qtdq)?"; then
        local orphans
        orphans=$(pacman -Qtdq 2>/dev/null || true)
        if [[ -n "$orphans" ]]; then
            # shellcheck disable=SC2086
            run pacman -Rns --noconfirm $orphans
            ok "Orphan csomagok törölve."
        else
            ok "Nincs orphan csomag."
        fi
    fi
}

# ============================================================
cleanup_dkms() {
    info "DKMS modulok takarítása (340 + 390)..."

    if command -v dkms >/dev/null 2>&1; then
        local versions
        versions=$(dkms status 2>/dev/null | awk -F'[/,]' '/nvidia/{print $1"/"$2}' | sort -u)
        if [[ -n "$versions" ]]; then
            echo "$versions" | sed 's/^/    dkms: /'
            for v in $versions; do
                run dkms remove "$v" --all || warn "dkms remove $v hibázott"
            done
            run dkms status
            ok "DKMS tiszta."
        else
            ok "Nincs DKMS nvidia modul."
        fi
    else
        warn "dkms nincs telepítve, kihagyom."
    fi
}

# ============================================================
cleanup_files() {
    info "Fájlrendszer maradványok törlése..."

    local paths=(
        /usr/src/nvidia-340.108
        /usr/src/nvidia-390.157
        /usr/src/nvidia-340xx-utils
        /usr/src/nvidia-390xx-utils
        /var/lib/dkms/nvidia
        /var/lib/dkms/nvidia-340xx
        /var/lib/dkms/nvidia-390xx

        /usr/share/vulkan/icd.d/nvidia_icd.json
        /usr/share/vulkan/icd.d/nvidia_layers.json
        /usr/share/glvnd/egl_vendor.d/10_nvidia.json
        /etc/ld.so.conf.d/nvidia*.conf

        /etc/modprobe.d/nvidia*.conf
        /etc/modprobe.d/blacklist-nvidia*.conf
        /etc/modules-load.d/nvidia.conf
        /etc/modules-load.d/nvidia-utils.conf

        /etc/X11/xorg.conf.d/20-nvidia.conf
        /etc/X11/xorg.conf.d/10-nvidia-drm-outputclass.conf

        /etc/mhwd.d/nvidia*.conf
    )

    for p in "${paths[@]}"; do
        if compgen -G "$p" >/dev/null 2>&1 || [[ -e "$p" ]]; then
            info "  törlés: $p"
            run rm -rf -- "$p"
        fi
    done

    find /usr/lib /usr/lib32 -maxdepth 2 \( \
        -name 'libnvidia*' -o \
        -name 'libcuda*' -o \
        -name 'libGLX_nvidia*' -o \
        -name 'libEGL_nvidia*' -o \
        -name 'libnvcuvid*' -o \
        -name 'libnvidia-ngx*' \
    \) 2>/dev/null | while read -r f; do
        warn "  talált lib maradvány: $f"
        run rm -f -- "$f"
    done

    ok "Fájlrendszer tiszta."
}

# ============================================================
cleanup_build_dirs() {
    info "Build könyvtárak tisztítása..."

    local target_user="${SUDO_USER:-$USER}"
    local home
    home=$(getent passwd "$target_user" | cut -d: -f6)
    [[ -z "$home" ]] && home="$HOME"

    local dirs=(
        "$home/nvidia-340xx-utils"
        "$home/nvidia-390xx-utils"
    )

    for d in "${dirs[@]}"; do
        if [[ -d "$d" ]]; then
            info "  takarítás: $d"
            find "$d" -maxdepth 1 -type d -name 'src'  -exec rm -rf {} + 2>/dev/null
            find "$d" -maxdepth 1 -type d -name 'pkg'  -exec rm -rf {} + 2>/dev/null
            find "$d" -maxdepth 1 -type f -name '*.pkg.tar.zst'      -delete 2>/dev/null
            find "$d" -maxdepth 1 -type f -name '*.pkg.tar.zst.sig'  -delete 2>/dev/null
            ok "  kész: $d"
        else
            warn "  nincs: $d"
        fi
    done
}

# ============================================================
# Nested build dirs: ~/NVIDIA-390XX-UTILS/build/nvidia-390xx-utils
#                    ~/NVIDIA-340XX-UTILS/build/nvidia-340xx-utils
# Itt a `src` MARAD, csak `pkg` + .zst törlődik.
# ============================================================
cleanup_nested_build_dirs() {
    info "Nested build könyvtárak tisztítása (src MEGMARAD)..."

    local target_user="${SUDO_USER:-$USER}"
    local home
    home=$(getent passwd "$target_user" | cut -d: -f6)
    [[ -z "$home" ]] && home="$HOME"

    local dirs=(
        "$home/NVIDIA-390XX-UTILS/build/nvidia-390xx-utils"
        "$home/NVIDIA-340XX-UTILS/build/nvidia-340xx-utils"
    )

    for d in "${dirs[@]}"; do
        if [[ -d "$d" ]]; then
            info "  takarítás: $d"
            find "$d" -maxdepth 1 -type d -name 'pkg' -exec rm -rf {} + 2>/dev/null
            find "$d" -maxdepth 1 -type f -name '*.pkg.tar.zst'      -delete 2>/dev/null
            find "$d" -maxdepth 1 -type f -name '*.pkg.tar.zst.sig'  -delete 2>/dev/null
            ok "  kész: $d (src megtartva)"
        else
            warn "  nincs: $d"
        fi
    done
}

# ============================================================
refresh_initramfs() {
    if ! confirm "Initramfs újragenerálása (mkinitcpio -P)?"; then
        return
    fi
    if command -v mkinitcpio >/dev/null 2>&1; then
        run mkinitcpio -P || warn "mkinitcpio hibázott"
    else
        warn "mkinitcpio nincs telepítve."
    fi
}

# ============================================================
report() {
    local target_user="${SUDO_USER:-$USER}"
    local home
    home=$(getent passwd "$target_user" | cut -d: -f6)
    [[ -z "$home" ]] && home="$HOME"

    echo
    ok "Kész. Ellenőrzés (tényleges kimenet):"

    info "dkms status:"
    if (( DRY_RUN )); then
        echo -e "${Y}[dry]${N} dkms status"
    else
        dkms status 2>/dev/null || echo "  (nincs találat / dkms nem elérhető)"
    fi

    info "Telepített 340xx/390xx csomagok:"
    if (( DRY_RUN )); then
        echo -e "${Y}[dry]${N} pacman -Qq | grep -E 'nvidia-(340xx|390xx)'"
    else
        local found
        found=$(pacman -Qq 2>/dev/null | grep -E \
            '^(nvidia-(340xx|390xx).*|opencl-nvidia-(340xx|390xx).*|lib32-(nvidia|opencl-nvidia)-(340xx|390xx).*|nvidia-utils-(340xx|390xx).*)$' \
            || true)
        if [[ -n "$found" ]]; then
            echo "$found"
        else
            echo "  (egy sem — OK)"
        fi
    fi

    info "/usr/src és /var/lib/dkms nvidia maradványok:"
    if (( DRY_RUN )); then
        echo -e "${Y}[dry]${N} ls -d /usr/src/*nvidia* /var/lib/dkms/*nvidia*"
    else
        ls -d /usr/src/*nvidia* /var/lib/dkms/*nvidia* 2>/dev/null || echo "  (nincs)"
    fi

    info "Nested build könyvtárak (src marad):"
    if (( DRY_RUN )); then
        echo -e "${Y}[dry]${N} ls -d $home/NVIDIA-{340XX,390XX}-UTILS/build/nvidia-*xx-utils"
    else
        ls -d "$home/NVIDIA-390XX-UTILS/build/nvidia-390xx-utils" \
              "$home/NVIDIA-340XX-UTILS/build/nvidia-340xx-utils" 2>/dev/null \
              || echo "  (nincs)"
    fi
}

# ============================================================
main() {
    echo -e "${B}=== Nvidia 340xx / 390xx tisztító ===${N}"
    (( DRY_RUN )) && warn "DRY-RUN mód: semmi sem módosul."

    require_root "$@"

    cleanup_packages
    cleanup_dkms
    cleanup_files
    cleanup_build_dirs
    cleanup_nested_build_dirs
    refresh_initramfs
    report
}

main "$@"
